{
  "name": "textra",
  "version": "0.2.1",
  "description": "A local-first LaTeX desktop IDE",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:dev": "node tests/dev-smoke.mjs --restart-check",
    "test:startup": "node tests/performance/run-startup.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "pack:win": "npm run build && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.85",
    "@ai-sdk/deepseek": "3.0.70",
    "@ai-sdk/google": "4.0.102",
    "@ai-sdk/mistral": "4.0.69",
    "@ai-sdk/openai": "4.0.99",
    "@ai-sdk/openai-compatible": "3.0.75",
    "@ai-sdk/react": "4.0.152",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "4.7.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@retorquere/bibtex-parser": "^12.1.13",
    "@tanstack/react-virtual": "^3.14.22",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-italic": "3.32.0",
    "@tiptap/extension-mathematics": "3.32.0",
    "@tiptap/extension-subscript": "3.32.0",
    "@tiptap/extension-superscript": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/diff": "^7.0.2",
    "@types/which": "^3.0.4",
    "@unified-latex/unified-latex-types": "^1.8.4",
    "@unified-latex/unified-latex-util-align": "1.8.4",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "@unified-latex/unified-latex-util-to-string": "^1.8.4",
    "@unified-latex/unified-latex-util-visit": "^1.8.4",
    "ai": "7.0.148",
    "chokidar": "^6.0.0",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "jsonc-parser": "3.3.1",
    "katex": "0.18.10",
    "material-icon-theme": "5.39.0",
    "monaco-editor": "0.57.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tree-kill": "^1.2.2",
    "vscode-jsonrpc": "^10.0.0",
    "vscode-languageserver-protocol": "^3.18.5",
    "which": "^6.0.1",
    "y-monaco": "^0.1.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
